# Copy this file to .env and fill in your own values. Never commit .env.

# Used in the User-Agent so site owners can reach you if the bot misbehaves.
CONTACT_EMAIL=you@example.com

# Supabase (Phase 2). The service role key bypasses Row-Level Security:
# use it ONLY in the worker and /api, never in the web frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Telegram (Phase 4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# LLM scoring (Phase 3). LLM_PROVIDER: groq | openai | gemini | ollama
# LLM_MODEL can stay empty for groq (defaults to openai/gpt-oss-20b).
LLM_PROVIDER=groq
LLM_MODEL=
GROQ_API_KEY=
# Only for the other providers:
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Gmail read-only sync (Phase 7)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional: lets /add start a one-company baseline run right away via
# GitHub workflow_dispatch. Fine-grained token with "Actions: write" on this repo only.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=your-username/internradar
